<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Dress Collection — a curated collection of apparel, shoes and everyday accessories.">
  <title>Dress Collection | Fashion &amp; Accessories</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--rose:#b51f58;--rose-dark:#81143e;--pink:#fff0f5;--ink:#27232a;--muted:#77717a}
    *{box-sizing:border-box} body{font-family:"DM Sans",sans-serif;color:var(--ink);background:#fffafa}
    .site-header{background:#fff;box-shadow:0 3px 20px #5d18300d;position:sticky;top:0;z-index:20}
    .profile{width:54px;height:54px;object-fit:cover;border-radius:50%;border:2px solid #f3c3d4}
    .brand-logo{width:min(235px,38vw);max-height:74px;object-fit:contain}
    .navbar-nav .nav-link{font-weight:600;color:#51464d;padding:.65rem 1rem!important}
    .navbar-nav .nav-link:hover,.navbar-nav .nav-link.active{color:var(--rose)}
    .search-wrap{max-width:245px}.search-wrap input{border-radius:50px;border:1px solid #ead7df;background:#fff8fa;padding:.65rem 1rem}
    .hero{padding:34px 0 16px}.hero img{width:100%;max-height:310px;object-fit:contain;border-radius:18px;background:#fff}
    .section-heading{font-family:"Playfair Display",serif;font-weight:700;font-size:clamp(1.8rem,3vw,2.4rem);margin-bottom:.35rem}
    .section-sub{color:var(--muted);margin-bottom:1.6rem}
    .category-card{height:100%;border:1px solid #f1dce4;border-radius:17px;background:#fff;padding:13px;text-align:center;transition:.2s;cursor:pointer}
    .category-card:hover,.category-card.selected{transform:translateY(-4px);box-shadow:0 12px 28px #a52b5717;border-color:#e9a9c0}
    .category-card img{height:132px;width:100%;object-fit:contain;border-radius:11px;background:#fff}
    .category-card h3{font-size:1rem;font-weight:700;margin:12px 0 2px}
    .featured-card{border:1px solid #f1dce4;border-radius:17px;overflow:hidden;background:#fff;height:100%;transition:.2s}
    .featured-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px #a52b5718}
    .featured-card img{width:100%;height:205px;object-fit:contain;padding:13px;background:#fff}
    .featured-card .card-body{padding:14px 17px 18px}
    .featured-card h3{font-size:1.02rem;font-weight:700;margin:0}
    .tag{font-size:.75rem;color:var(--rose);background:var(--pink);border-radius:30px;padding:5px 10px}
    .contact-panel{background:#fff;border:1px solid #f0dce4;border-radius:20px;padding:25px}
    .form-control{border-color:#ead7df;border-radius:10px;padding:.75rem .9rem}
    .form-control:focus{border-color:#d77b9d;box-shadow:0 0 0 .2rem #d77b9d25}
    .btn-rose{background:var(--rose);color:#fff;border:0;border-radius:50px;padding:.7rem 1.5rem;font-weight:700}
    .btn-rose:hover{background:var(--rose-dark);color:#fff}
    .contact-icon{width:46px;height:46px;display:inline-flex;align-items:center;justify-content:center;background:var(--pink);color:var(--rose);border-radius:50%;font-size:1.35rem;text-decoration:none}
    footer{background:#fff;border-top:1px solid #f0dce4;color:#766b72}
    .bottom-brand{width:min(340px,80%);max-height:135px;object-fit:contain}
    .empty-state{display:none;color:var(--muted);padding:25px;text-align:center}
    @media(max-width:767px){.hero{padding-top:20px}.brand-logo{width:155px}.profile{width:45px;height:45px}.search-wrap{max-width:100%;margin-top:10px}.category-card img{height:115px}.featured-card img{height:175px}}
  </style>
</head>
<body>
<header class="site-header">
  <nav class="navbar navbar-expand-lg py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-3 me-lg-4" href="#home" aria-label="Dress Collection home">
        <img class="profile" src="assets/profile-fs.jpg" alt="Profile photo">
        <img class="brand-logo" src="assets/dress-collection-logo.png" alt="Dress Collection logo">
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link active" href="#home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#collection">Collection</a></li>
          <li class="nav-item"><a class="nav-link" href="#featured">Featured</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
        </ul>
        <div class="search-wrap"><input id="siteSearch" class="form-control" type="search" placeholder="Search collection..." aria-label="Search collection"></div>
      </div>
    </div>
  </nav>
</header>

<main id="home">
  <section class="hero">
    <div class="container"><img src="assets/dress-collection-banner.png" alt="Dress Collection — glamorous pink and gold fashion banner"></div>
  </section>

  <section id="collection" class="py-5">
    <div class="container">
      <div class="text-center mb-4">
        <h1 class="section-heading">Shop by Collection</h1>
        <p class="section-sub">Find your style, from everyday essentials to standout pieces.</p>
      </div>
      <div class="row g-3 g-md-4" id="categoryGrid">
        <div class="col-6 col-md-3"><article class="category-card" data-filter="t-shirt" tabindex="0" role="button" aria-label="Filter T-shirt"><img src="assets/tshirt-family.jpg" alt="Printed white T-shirt"><h3>T-shirt</h3></article></div>
        <div class="col-6 col-md-3"><article class="category-card" data-filter="shoes" tabindex="0" role="button" aria-label="Filter Shoes"><img src="assets/white-shoes.jpg" alt="White casual shoes"><h3>Shoes</h3></article></div>
        <div class="col-6 col-md-3"><article class="category-card" data-filter="rubber shoes" tabindex="0" role="button" aria-label="Filter Rubber Shoes"><img src="assets/sneakers.jpg" alt="Sporty rubber shoes"><h3>Rubber Shoes</h3></article></div>
        <div class="col-6 col-md-3"><article class="category-card" data-filter="laptop bag" tabindex="0" role="button" aria-label="Filter Laptop Bag"><img src="assets/laptop-backpack.jpg" alt="Gray laptop backpack"><h3>Laptop Bag</h3></article></div>
      </div>
    </div>
  </section>

  <section id="featured" class="py-5" style="background:linear-gradient(180deg,#fff5f8,#fffafa)">
    <div class="container">
      <div class="text-center mb-4"><h2 class="section-heading">Featured Collection</h2><p class="section-sub">A few favorites selected for you.</p></div>
      <div class="row g-3 g-md-4" id="featuredGrid">
        <div class="col-12 col-sm-6 col-lg-4 product-item" data-name="sneakers rubber shoes footwear">
          <article class="featured-card"><img src="assets/sneakers.jpg" alt="White and gray sporty sneakers"><div class="card-body d-flex justify-content-between align-items-center gap-2"><h3>Sneakers</h3><span class="tag">Footwear</span></div></article>
        </div>
        <div class="col-12 col-sm-6 col-lg-4 product-item" data-name="chanel apparel handbag fashion">
          <article class="featured-card"><img src="assets/chanel-apparel.jpg" alt="Brown elegant handbag"><div class="card-body d-flex justify-content-between align-items-center gap-2"><h3>Chanel Apparel</h3><span class="tag">Apparel</span></div></article>
        </div>
        <div class="col-12 col-sm-6 col-lg-4 product-item" data-name="rog laptop bag backpack">
          <article class="featured-card"><img src="assets/laptop-backpack.jpg" alt="Gray ROG-style laptop backpack"><div class="card-body d-flex justify-content-between align-items-center gap-2"><h3>ROG Laptop Bag</h3><span class="tag">Accessories</span></div></article>
        </div>
      </div>
      <p class="empty-state" id="emptyState">No matching items found. Try another search.</p>
    </div>
  </section>

  <section id="contact" class="py-5">
    <div class="container">
      <div class="text-center mb-4"><h2 class="section-heading">Get in Touch</h2><p class="section-sub">Questions about an item? Send us a message.</p></div>
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="contact-panel">
            <form id="contactForm" class="row g-3">
              <div class="col-md-6"><label for="name" class="form-label fw-semibold">Name</label><input class="form-control" id="name" name="name" placeholder="Your name" required></div>
              <div class="col-md-6"><label for="email" class="form-label fw-semibold">Email address</label><input class="form-control" type="email" id="email" name="email" placeholder="you@example.com" required></div>
              <div class="col-12"><label for="description" class="form-label fw-semibold">Description</label><textarea class="form-control" id="description" name="description" rows="4" placeholder="How can we help?" required></textarea></div>
              <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex gap-3">
                  <a class="contact-icon" href="mailto:hello@dresscollection.example" aria-label="Email Dress Collection" title="Email"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 7 9-7M12 2v5"/></svg></a>
                  <a class="contact-icon" href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook"><svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4z"/></svg></a>
                  <a class="contact-icon" href="tel:+630000000000" aria-label="Call Dress Collection" title="Phone"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.3.4 2.7.6 4.1.6.7 0 1.3.6 1.3 1.3v3.5c0 .7-.6 1.3-1.3 1.3C10.2 21.6 2.4 13.8 2.4 3.3 2.4 2.6 3 2 3.7 2h3.5c.7 0 1.3.6 1.3 1.3 0 1.4.2 2.8.6 4.1.1.4 0 .9-.3 1.2l-2.2 2.2z"/></svg></a>
                </div>
                <button class="btn btn-rose" type="submit">Send Message</button>
              </div>
              <div class="col-12"><div id="formMessage" class="small" role="status" aria-live="polite"></div></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="py-4">
  <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
    <img class="bottom-brand" src="assets/dress-collection-banner.png" alt="Dress Collection">
    <p class="mb-0 small">© <span id="year"></span> Dress Collection. All rights reserved.</p>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const search = document.getElementById('siteSearch');
  const products = [...document.querySelectorAll('.product-item')];
  const emptyState = document.getElementById('emptyState');
  function filterProducts(term) {
    const query = term.trim().toLowerCase();
    let visible = 0;
    products.forEach(item => {
      const match = item.dataset.name.includes(query);
      item.classList.toggle('d-none', !match);
      if (match) visible++;
    });
    emptyState.style.display = visible ? 'none' : 'block';
  }
  search.addEventListener('input', e => filterProducts(e.target.value));
  document.querySelectorAll('.category-card').forEach(card => {
    const activate = () => {
      document.querySelectorAll('.category-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      const category = card.dataset.filter;
      search.value = category === 'rubber shoes' ? 'sneakers' : category === 'laptop bag' ? 'laptop bag' : category;
      filterProducts(search.value);
      document.getElementById('featured').scrollIntoView({behavior:'smooth'});
    };
    card.addEventListener('click', activate);
    card.addEventListener('keydown', e => { if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }});
  });
  document.getElementById('contactForm').addEventListener('submit', e => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!form.reportValidity()) return;
    document.getElementById('formMessage').textContent = 'Thank you! Your message is ready. Connect your email service to receive submissions.';
    document.getElementById('formMessage').className = 'small text-success';
    form.reset();
  });
  document.getElementById('year').textContent = new Date().getFullYear();
</script>
</body>
</html>
